---
import BaseLayout from '@pbn/core/layouts/BaseLayout.astro'
import '../styles/theme.css'
import ArticlePage from '@pbn/core/components/ArticlePage.astro'
import { getArticlesForSite, getSiteConfig } from '@pbn/core/lib/content'

export async function getStaticPaths() {
  const siteId = import.meta.env.SITE_ID
  if (!siteId) throw new Error('Missing SITE_ID env var')

  const articles = await getArticlesForSite(siteId)

  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }))
}

const { article } = Astro.props

const siteId = import.meta.env.SITE_ID
const siteConfig = await getSiteConfig(siteId)
const siteName = siteConfig?.name || 'Blog'
const siteUrl = import.meta.env.SITE_URL || `https://${siteConfig?.domain || 'localhost:9001'}`
---

<BaseLayout title={article.title} siteName={siteName} siteUrl={siteUrl}>
  <ArticlePage
    slot="default"
    title={article.title}
    content={article.content}
    slug={article.slug}
    description={article.meta_description}
    keywords={article.target_keywords}
    articleType={article.article_type}
    publishedAt={article.created_at}
    updatedAt={article.updated_at}
    siteName={siteName}
    siteUrl={siteUrl}
  />
</BaseLayout>
